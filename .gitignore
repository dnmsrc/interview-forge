node_modules/
out/
data/*.db*
# QA 产物：CDP 截图与报告（7MB+，本机看即可，不入库）
data/qa/
data/backups/
# Electron 运行时用户数据（Cache / leveldb / Cookies 会被进程锁住，git add 会直接报 Permission denied）
data/electron-userData/
# 多开实例的运行目录（npm run dev:2 / --own-data 生成）
data/electron-userData-*/
data/instances/
# 一次性探针产物 / 内容备份，不该跟着仓库走
data/r24-qa/
data/_backup*/
data/e2e-*.png
scripts/.tmp-*
.DS_Store
*.log
.env

# ---------- 大文件：模型与推理运行时绝不入库 ----------
# 本地模型按需下载（见 README「本地模型」），仓库只保留代码与题库内容。
# 模型默认放在项目外（D:/model/forge-tutor 或 ~/.forge-tutor），这里只是兜底。
*.gguf
*.gguf.part
*.bin
*.safetensors
llama/

# ---------- 构建缓存 ----------
*.tsbuildinfo

# ---------- 误创建的临时文件 ----------
# Windows 下 `node xxx 2>nul` 会真的生成一个名为 nul 的文件
nul

# ---------- 本地快照 / 临时探针 ----------
snapshots/
scripts/.tmp-rag/data/plans/
