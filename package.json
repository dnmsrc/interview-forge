{
  "name": "interview-forge",
  "version": "0.1.0",
  "private": false,
  "description": "练习册 · 完全本地的技术练习客户端：题库练习/闭卷考试/知识图谱/FSRS 间隔重复/带引用校验的本地 AI 私教",
  "license": "MIT",
  "main": "./out/main/index.js",
  "author": "harry",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dnmsrc/interview-forge.git"
  },
  "homepage": "https://github.com/dnmsrc/interview-forge#readme",
  "bugs": {
    "url": "https://github.com/dnmsrc/interview-forge/issues"
  },
  "keywords": [
    "electron",
    "vue3",
    "typescript",
    "interview",
    "flashcards",
    "fsrs",
    "spaced-repetition",
    "knowledge-graph",
    "sqlite",
    "fts5",
    "llama.cpp",
    "local-llm",
    "rag"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:2": "node scripts/dev.mjs --instance=2",
    "dev:3": "node scripts/dev.mjs --instance=3",
    "dev:bg": "node scripts/dev-detach.mjs",
    "dev:multi": "node scripts/dev-multi.mjs",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "seed": "node scripts/seed.mjs",
    "qa": "node scripts/qa/regress.mjs",
    "kb:index": "node scripts/kb-index.mjs",
    "kb:build": "node scripts/kb-build.mjs",
    "typecheck": "vue-tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "tutor:fetch": "node scripts/tutor-fetch.mjs",
    "project:check": "node scripts/qa/project-content.test.mjs",
    "project:build": "node scripts/project-build.mjs",
    "project:coverage": "node scripts/project-coverage.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "electron": "^45.2.3",
    "electron-vite": "^6.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "vue-tsc": "^3.3.14"
  },
  "dependencies": {
    "@guolao/vue-monaco-editor": "^1.6.0",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "echarts": "^6.1.0",
    "markdown-it": "^15.0.3",
    "monaco-editor": "^0.57.0",
    "naive-ui": "^2.45.3",
    "pinia": "^4.1.0",
    "prismjs": "^1.30.0",
    "vue": "^3.5.45",
    "vue-echarts": "^8.3.2",
    "vue-router": "^5.4.0"
  }
}
